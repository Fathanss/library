export interface Book {
  id: number;
  full_name: string;
  description: string;
  code_book: string;
  location_id: number;
  status: string;
}

export interface BookPayload {
  full_name: string;
  description: string;
  code_book: string;
  location_id: number;
  status: string;
}

const BASE_URL = '/api/books';

export const bookService = {
  // Fetch all books
  async getAll(): Promise<Book[]> {
    const res = await fetch(BASE_URL);
    const result = await res.json().catch(() => null);
    
    if (!res.ok) {
      throw new Error(result?.message || `Failed to fetch books (${res.status})`);
    }
    return result?.data ?? result;
  },

  // Create new book (POST)
  async create(payload: BookPayload): Promise<Book> {
    // Memastikan location_id terkonversi ke number
    const formattedPayload = {
      ...payload,
      location_id: Number(payload.location_id),
    };

    const res = await fetch(BASE_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formattedPayload),
    });

    const result = await res.json().catch(() => null);

    if (!res.ok) {
      throw new Error(result?.message || `Failed to create book (${res.status})`);
    }
    return result?.data ?? result;
  },

  // Update existing book (PUT)
  async update(id: number, payload: BookPayload): Promise<Book> {
    const formattedPayload = {
      ...payload,
      location_id: Number(payload.location_id),
    };

    const res = await fetch(`${BASE_URL}/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formattedPayload),
    });

    const result = await res.json().catch(() => null);

    if (!res.ok) {
      throw new Error(result?.message || `Failed to update book (${res.status})`);
    }
    return result?.data ?? result;
  },

  // Delete book (DELETE)
  async remove(id: number): Promise<void> {
    const res = await fetch(`${BASE_URL}/${id}`, {
      method: 'DELETE',
    });

    if (!res.ok) {
      const result = await res.json().catch(() => null);
      throw new Error(result?.message || `Failed to delete book (${res.status})`);
    }
  },
};